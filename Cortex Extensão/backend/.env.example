#
# Backend local configuration
# Required values must be filled before starting the API.
#
PORT=3002
NODE_ENV=development

# Required for local API
DATABASE_URL=
JWT_SECRET=

# Optional when using Supabase sync
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional when using Google auth
GOOGLE_CLIENT_ID=
GOOGLE_EXTENSION_CLIENT_ID=

# Optional when using AI explanations
GEMINI_API_KEY=
