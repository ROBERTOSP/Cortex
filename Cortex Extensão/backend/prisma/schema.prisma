generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StudyGoalType {
  APPROVAL
  GENERAL_STUDY
  CAREER_TRANSITION
}

enum StudyGoalPhase {
  PRE_NOTICE
  POST_NOTICE
}

enum StudyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnergyPeriod {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum FatigueLevel {
  LOW
  MEDIUM
  HIGH
}

enum StudyContext {
  HOME
  WORK
  COMMUTE
  LIBRARY
  OTHER
}

enum DeviceType {
  DESKTOP
  LAPTOP
  TABLET
  PHONE
  PAPER
}

enum WindowFlexibility {
  STRICT
  FLEXIBLE
}

enum AllowedActivity {
  THEORY
  REVIEW
  QUESTIONS
  FLASHCARDS
  VIDEO
  AUDIO
  NOTES
  SIMULATION
  ESSAY_PRACTICE
}

enum CommitmentCategory {
  WORK
  COMMUTE
  COLLEGE
  FAMILY
  EXERCISE
  OTHER
}

enum PlanMode {
  RIGID
  FLEXIBLE
}

enum MissedDayStrategy {
  REDISTRIBUTE
  ASK_BEFORE
  KEEP_PENDING
  DROP_LOW_PRIORITY
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum QuestionRightsStatus {
  PENDING
  INTERNAL_RESTRICTED
  AUTHORIZED
  LICENSED
  OFFICIAL_SOURCE_REVIEW
  REMOVED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  avatarUrl       String?
  googleId        String?  @unique
  passwordHash    String?  @map("password_hash")
  phone           String?
  selfDeclaredColor String? @map("self_declared_color")
  hasDisability   Boolean? @map("has_disability")
  birthDate       DateTime? @map("birth_date")
  sex             String?
  city            String?
  availableOtherStates Boolean? @map("available_other_states")
  tokens          Int      @default(100)
  
  // Perfil Cognitivo / Rotina
  studyLevel      String?  // Ativo, Inativo
  dailyStudyHours Int?
  fatigueLevel    String?  // Baixo, Médio, Alto
  peakEnergyTime  String?  // Manhã, Tarde, Noite
  works           Boolean  @default(false)

  onboardingVersion Int    @default(0) @map("onboarding_version")
  studyGoal         StudyGoal?
  routine           UserRoutine?
  dailyCheckIns     DailyCheckIn[]
  
  contests        Contest[]
  studySessions   StudySession[]
  questionAttempts QuestionAttempt[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
}

model StudyGoal {
  id              String         @id @default(uuid())

  userId          String         @unique @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            StudyGoalType
  studyLevel      StudyLevel     @map("study_level")
  phase           StudyGoalPhase

  title           String         @map("title")
  targetJob       String         @map("target_job")
  board           String?        @map("board")

  examDate        DateTime?      @map("exam_date")
  examDateUnknown Boolean        @default(false) @map("exam_date_unknown")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([type])
  @@map("study_goals")
}

model UserRoutine {
  id                          String            @id @default(uuid())

  userId                      String            @unique @map("user_id")
  user                        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingSchemaVersion     Int               @default(1) @map("onboarding_schema_version")

  timezone                    String?           @map("timezone")

  wakeTimeMinute              Int?              @map("wake_time_minute")
  sleepTimeMinute             Int?              @map("sleep_time_minute")

  peakEnergyPeriod            EnergyPeriod?     @map("peak_energy_period")
  habitualFatigueLevel        FatigueLevel?     @map("habitual_fatigue_level")

  preferredSessionMinutes     Int?              @map("preferred_session_minutes")
  planMode                    PlanMode?         @map("plan_mode")
  maxSubjectsPerDay           Int?              @map("max_subjects_per_day")

  wantsDayOff                 Boolean           @default(false) @map("wants_day_off")
  dayOffPreference            DayOfWeek?        @map("day_off_preference")

  badDayMinimumMinutes        Int?              @map("bad_day_minimum_minutes")
  missedDayStrategy           MissedDayStrategy? @map("missed_day_strategy")

  routineOnboardingCompletedAt DateTime?        @map("routine_onboarding_completed_at")

  availabilityWindows         AvailabilityWindow[]
  commitments                 RoutineCommitment[]
  dailyCheckIns               DailyCheckIn[]

  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")

  @@index([timezone])
  @@map("user_routines")
}

model AvailabilityWindow {
  id                String           @id @default(uuid())

  routineId         String           @map("routine_id")
  routine           UserRoutine      @relation(fields: [routineId], references: [id], onDelete: Cascade)

  dayOfWeek         DayOfWeek        @map("day_of_week")
  startMinute       Int              @map("start_minute")
  endMinute         Int              @map("end_minute")

  context           StudyContext
  devices           DeviceType[]     @default([]) @map("devices")
  flexibility       WindowFlexibility

  allowedActivities AllowedActivity[] @default([]) @map("allowed_activities")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([routineId, dayOfWeek, startMinute, endMinute])
  @@index([routineId, dayOfWeek])
  @@index([routineId, dayOfWeek, startMinute])
  @@map("availability_windows")
}

model RoutineCommitment {
  id          String           @id @default(uuid())

  routineId   String           @map("routine_id")
  routine     UserRoutine      @relation(fields: [routineId], references: [id], onDelete: Cascade)

  category    CommitmentCategory
  dayOfWeek   DayOfWeek        @map("day_of_week")
  startMinute Int              @map("start_minute")
  endMinute   Int              @map("end_minute")
  flexibility WindowFlexibility

  note        String?          @db.VarChar(140)

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([routineId, dayOfWeek, startMinute, endMinute, category])
  @@index([routineId, dayOfWeek])
  @@index([routineId, dayOfWeek, startMinute])
  @@map("routine_commitments")
}

model DailyCheckIn {
  id                      String       @id @default(uuid())

  userId                  String       @map("user_id")
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  routineId               String?      @map("routine_id")
  routine                 UserRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  dateKey                 String       @map("date_key")
  timezone                String       @map("timezone")

  energy                  Int
  focus                   Int
  fatigue                 Int
  availableMinutesOverride Int?        @map("available_minutes_override")

  note                    String?      @db.VarChar(200)

  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  @@unique([userId, dateKey])
  @@map("daily_check_ins")
}

model Contest {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  name            String   // Ex: PCDF
  targetJob       String   // Ex: Agente
  board           String   // Ex: Cebraspe
  examDate        DateTime?
  status          String   @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED, ARCHIVED
  editalSource    String?  @map("edital_source") // CATALOG, TEXT, PDF, LINK
  editalSourceUrl String?  @map("edital_source_url")
  editalDraft     Json?    @map("edital_draft")
  editalExtractedAt DateTime? @map("edital_extracted_at")
  editalConfirmedAt DateTime? @map("edital_confirmed_at")
  selectedJob       String?  @map("selected_job")
  editalVersions    EditalVersion[]
  
  nodes           KnowledgeNode[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contests")
}

model EditalVersion {
  id              String   @id @default(uuid())
  contestId       String   @map("contest_id")
  contest         Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sequence        Int
  sourceType      String   @map("source_type")
  sourceUrl       String?  @map("source_url")
  fileName        String?  @map("file_name")
  contentHash     String?  @map("content_hash")
  sourceText      String?  @map("source_text")
  extraction      Json     @map("extraction")
  status          String   @default("REVIEW")
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  activatedAt     DateTime? @map("activated_at")

  @@unique([contestId, sequence])
  @@index([contestId, isActive])
  @@map("edital_versions")
}

model KnowledgeNode {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  
  parentId    String?
  parent      KnowledgeNode?  @relation("NodeHierarchy", fields: [parentId], references: [id])
  children    KnowledgeNode[] @relation("NodeHierarchy")
  
  name        String   // Ex: Direito Constitucional, Crase
  type        String   // SUBJECT, TOPIC, SUBTOPIC, CONCEPT
  
  // Métricas Cortex™
  mastery     Float    @default(0) // 0-100
  retention   Float    @default(0) // 0-100
  difficulty  Float    @default(0) // 0-100 (Percebida pelo usuário)
  taxonomyStatus String @default("PENDING") @map("taxonomy_status") // PENDING, MATCHED, AMBIGUOUS, UNMATCHED
  taxonomyMatch  Json?  @map("taxonomy_match")
  taxonomyMatchedAt DateTime? @map("taxonomy_matched_at")
  strategicPriority Float @default(0) @map("strategic_priority")
  priorityEvidence Json? @map("priority_evidence")
  priorityCalculatedAt DateTime? @map("priority_calculated_at")
  
  notes       Note[]
  flashcards  Flashcard[]
  questions   Question[] @relation("KnowledgeNodeQuestions")
  revisions   Revision[]
  studySessions StudySession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("knowledge_nodes")
}

model Note {
  id          String   @id @default(uuid())
  nodeId      String
  node        KnowledgeNode @relation(fields: [nodeId], references: [id])
  
  content     String   @db.Text // Conteúdo Notion-style (JSON ou Markdown)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notes")
}

model Flashcard {
  id          String   @id @default(uuid())
  nodeId      String
  node        KnowledgeNode @relation(fields: [nodeId], references: [id])
  
  front       String
  back        String
  difficulty  Float    @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("flashcards")
}

model Question {
  id                    String            @id @default(uuid())
  knowledgeNodeId       String?           @map("nodeId")
  knowledgeNode         KnowledgeNode?    @relation("KnowledgeNodeQuestions", fields: [knowledgeNodeId], references: [id])

  cortexIdNum           Int               @unique @map("cortex_id_num")
  cortexId              String            @unique @map("cortex_id")
  statement             String            @db.Text
  associatedText        String?           @db.Text @map("associated_text")
  officialAnswer        String?           @map("official_answer")
  difficulty            String?
  difficultyNum         Int?              @map("difficulty_num")
  type                  String?
  annulled              Boolean           @default(false)
  outdated              Boolean           @default(false)
  year                  Int?
  exam                  String?
  contentText           String            @db.Text @map("content_text")
  contentHash           String            @unique @map("content_hash")
  rawJson               Json?             @map("raw_json")
  statementImages       String[]          @default([]) @map("statement_images")
  itemImages            String[]          @default([]) @map("item_images")
  associatedTextImages  String[]          @default([]) @map("associated_text_images")
  importBatch           String?           @map("import_batch")

  boardId               String?           @map("board_id")
  board                 QuestionBoard?    @relation(fields: [boardId], references: [id])
  subjectId             String?           @map("subject_id")
  subject               QuestionSubject?  @relation(fields: [subjectId], references: [id])
  topicId               String?           @map("topic_id")
  topic                 QuestionTopic?    @relation(fields: [topicId], references: [id])
  subtopicId            String?           @map("subtopic_id")
  subtopic              QuestionSubtopic? @relation(fields: [subtopicId], references: [id])

  options               QuestionOption[]
  attempts              QuestionAttempt[]
  provenance            QuestionProvenance?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([year])
  @@index([boardId])
  @@index([subjectId])
  @@index([topicId])
  @@index([subtopicId])
  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String   @map("question_id")
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  letter       String
  text         String   @db.Text
  isCorrect    Boolean  @default(false) @map("is_correct")
  displayOrder Int      @default(0) @map("display_order")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([questionId, letter])
  @@index([questionId, displayOrder])
  @@map("question_options")
}

model QuestionProvenance {
  id                    String               @id @default(uuid())
  questionId            String               @unique @map("question_id")
  question              Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)

  sourceSystem          String               @map("source_system")
  sourceRecordId        String?              @map("source_record_id")
  sourceFile            String?              @map("source_file")
  sourceUrl             String?              @map("source_url")
  primarySourceUrl      String?              @map("primary_source_url")
  provenanceConfidence  String               @default("UNVERIFIED") @map("provenance_confidence")
  rightsStatus          QuestionRightsStatus @default(PENDING) @map("rights_status")
  rightsBasis           String?              @db.Text @map("rights_basis")
  reviewedAt            DateTime?            @map("reviewed_at")
  reviewedBy            String?              @map("reviewed_by")

  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@index([rightsStatus])
  @@index([sourceSystem])
  @@map("question_provenance")
}

model BoardTopicAggregate {
  id                  String   @id @default(uuid())
  boardName           String   @map("board_name")
  boardCanonicalKey   String   @map("board_canonical_key")
  subjectName         String   @map("subject_name")
  subjectCanonicalKey String   @map("subject_canonical_key")
  topicName           String   @map("topic_name")
  topicCanonicalKey   String   @map("topic_canonical_key")
  subtopicName        String   @map("subtopic_name")
  subtopicCanonicalKey String  @map("subtopic_canonical_key")
  year                Int?
  yearKey             String   @map("year_key")
  questionCount       Int      @map("question_count")
  activeQuestionCount Int      @map("active_question_count")
  averageDifficulty   Float?   @map("average_difficulty")
  confidence          String
  sourceStatus        String   @map("source_status")
  sourceGeneratedAt   DateTime? @map("source_generated_at")
  importedAt          DateTime @default(now()) @map("imported_at")

  @@unique([boardCanonicalKey, subjectCanonicalKey, topicCanonicalKey, subtopicCanonicalKey, yearKey])
  @@index([boardCanonicalKey, subjectCanonicalKey])
  @@index([boardCanonicalKey, topicCanonicalKey])
  @@index([boardCanonicalKey, year])
  @@map("board_topic_aggregates")
}

model QuestionBoard {
  id        String     @id @default(uuid())
  name      String     @unique
  canonicalKey String? @map("canonical_key")
  questions Question[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([canonicalKey])
  @@map("question_boards")
}

model QuestionSubject {
  id        String          @id @default(uuid())
  name      String          @unique
  canonicalKey String?      @map("canonical_key")
  questions Question[]
  topics    QuestionTopic[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([canonicalKey])
  @@map("question_subjects")
}

model QuestionTopic {
  id         String             @id @default(uuid())
  name       String
  canonicalKey String?      @map("canonical_key")
  subjectId  String?            @map("subject_id")
  subject    QuestionSubject?   @relation(fields: [subjectId], references: [id])
  questions  Question[]
  subtopics  QuestionSubtopic[]

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([name, subjectId])
  @@index([canonicalKey, subjectId])
  @@index([subjectId])
  @@map("question_topics")
}

model QuestionSubtopic {
  id         String          @id @default(uuid())
  name       String
  canonicalKey String?      @map("canonical_key")
  topicId    String?         @map("topic_id")
  topic      QuestionTopic?  @relation(fields: [topicId], references: [id])
  questions  Question[]

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([name, topicId])
  @@index([canonicalKey, topicId])
  @@index([topicId])
  @@map("question_subtopics")
}

model QuestionAttempt {
  id                String   @id @default(uuid())

  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])

  questionId        String   @map("question_id")
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption    String   @map("selected_option")
  correctOption     String   @map("correct_option")
  isCorrect         Boolean  @map("is_correct")

  latencyMs         Int?     @map("latency_ms")
  switchesCount     Int?     @map("switches_count")
  hesitationDetected Boolean? @map("hesitation_detected")

  explanation       String?  @db.Text @map("explanation")
  explainedAt       DateTime? @map("explained_at")

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([questionId])
  @@map("question_attempts")
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  nodeId      String
  node        KnowledgeNode @relation(fields: [nodeId], references: [id])
  
  startTime   DateTime @default(now())
  endTime     DateTime?
  duration    Int?     // Segundos
  focusScore  Float?   // 0-100
  fatigueLevel String?
  
  createdAt   DateTime @default(now())

  @@map("study_sessions")
}

model Revision {
  id          String   @id @default(uuid())
  nodeId      String
  node        KnowledgeNode @relation(fields: [nodeId], references: [id])
  
  scheduledFor DateTime
  completedAt  DateTime?
  score        Float?    // Desempenho na revisão
  
  createdAt    DateTime @default(now())

  @@map("revisions")
}
