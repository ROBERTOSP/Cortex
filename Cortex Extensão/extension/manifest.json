{
  "manifest_version": 3,
  "name": "Cortex",
  "version": "1.0.0",
  "description": "Digital Cognitive Twin para alta performance em concursos.",
  "permissions": ["storage", "identity", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "75677993515-f6melbm90n2s0a905itm618mrm26iv0m.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "action": {
    "default_title": "Abrir Cortex"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://0.0.0.0/*",
        "*://*.local/*",
        "*://192.168.*/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
